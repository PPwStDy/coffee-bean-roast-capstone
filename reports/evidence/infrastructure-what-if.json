    {
      "after": {
        "apiVersion": "2022-04-01",
        "id": "/subscriptions/6638a4ea-96da-4326-969a-2e40305cfc83/resourceGroups/rg-itcs355-6688218-capstone/providers/Microsoft.Insights/workbooks/1f289b63-43ca-5130-a7e6-abc93b51060f",
        "kind": "shared",
        "location": "eastasia",
        "name": "1f289b63-43ca-5130-a7e6-abc93b51060f",
        "properties": {
          "category": "workbook",
          "displayName": "Coffee roast API operations",
          "serializedData": "{\n  \"version\": \"Notebook/1.0\",\n  \"items\": [\n    {\n      \"type\": 1,\n      \"content\": {\n        \"json\": \"# Coffee roast API operations\\nStructured application logs, HTTP status/latency and camera rejection events.\"\n      },\n      \"name\": \"intro\"\n    },\n    {\n      \"type\": 3,\n      \"content\": {\n        \"version\": \"KqlItem/1.0\",\n        \"query\": \"ContainerAppConsoleLogs_CL | extend e=parse_json(Log_s) | where tostring(e.event)==\\\"http_request\\\" | summarize Requests=count() by Status=tostring(e.status), bin(TimeGenerated, 1m)\",\n        \"size\": 0,\n        \"title\": \"Request volume and status\",\n        \"queryType\": 0,\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\n        \"crossComponentResources\": [\n          \"/subscriptions/6638a4ea-96da-4326-969a-2e40305cfc83/resourceGroups/rg-itcs355-6688218-capstone/providers/Microsoft.OperationalInsights/workspaces/coffee6688218-logs\"\n        ],\n        \"timeContext\": {\n          \"durationMs\": 3600000\n        },\n        \"visualization\": \"timechart\"\n      },\n      \"name\": \"Request volume and status\"\n    },\n    {\n      \"type\": 3,\n      \"content\": {\n        \"version\": \"KqlItem/1.0\",\n        \"query\": \"ContainerAppConsoleLogs_CL | extend e=parse_json(Log_s) | where tostring(e.event)==\\\"http_request\\\" and tostring(e.path)==\\\"/predict\\\" | summarize p50=percentile(todouble(e.latency_ms),50), p95=percentile(todouble(e.latency_ms),95), p99=percentile(todouble(e.latency_ms),99) by bin(TimeGenerated,1m)\",\n        \"size\": 0,\n        \"title\": \"HTTP latency p50/p95/p99\",\n        \"queryType\": 0,\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\n        \"crossComponentResources\": [\n          \"/subscriptions/6638a4ea-96da-4326-969a-2e40305cfc83/resourceGroups/rg-itcs355-6688218-capstone/providers/Microsoft.OperationalInsights/workspaces/coffee6688218-logs\"\n        ],\n        \"timeContext\": {\n          \"durationMs\": 3600000\n        },\n        \"visualization\": \"timechart\"\n      },\n      \"name\": \"HTTP latency p50/p95/p99\"\n    },\n    {\n      \"type\": 3,\n      \"content\": {\n        \"version\": \"KqlItem/1.0\",\n        \"query\": \"ContainerAppConsoleLogs_CL | extend e=parse_json(Log_s) | where tostring(e.event)==\\\"occlusion_guard_rejection\\\" | project TimeGenerated, ContainerAppName_s, PixelStd=todouble(e.pixel_std), Entropy=todouble(e.entropy)\",\n        \"size\": 0,\n        \"title\": \"Camera occlusion\",\n        \"queryType\": 0,\n        \"resourceType\": \"microsoft.operationalinsights/workspaces\",\n        \"crossComponentResources\": [\n          \"/subscriptions/6638a4ea-96da-4326-969a-2e40305cfc83/resourceGroups/rg-itcs355-6688218-capstone/providers/Microsoft.OperationalInsights/workspaces/coffee6688218-logs\"\n        ],\n        \"timeContext\": {\n          \"durationMs\": 3600000\n        },\n        \"visualization\": \"table\"\n      },\n      \"name\": \"Camera occlusion\"\n    }\n  ],\n  \"isLocked\": false\n}\n",
          "sourceId": "/subscriptions/6638a4ea-96da-4326-969a-2e40305cfc83/resourceGroups/rg-itcs355-6688218-capstone/providers/Microsoft.OperationalInsights/workspaces/coffee6688218-logs"
        },
        "resourceGroup": "rg-itcs355-6688218-capstone",
        "tags": {
          "course": "itcs355",
          "lab": "capstone",
          "student": "6688218"
        },
        "type": "Microsoft.Insights/workbooks"
